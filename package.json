{
  "name": "ok-despacho-online",
  "version": "0.6.3-rc1",
  "private": true,
  "type": "module",
  "description": "OK Despacho Online — Fase 1.1: login, usuarios y permisos, panel del Operario (lógica v15), seguridad de usuarios y base de aprobación de rutas internas.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:functions": "deno test --allow-read --config supabase/functions/deno.json supabase/functions",
    "test:pdf": "bash tests/pdf/check_pdf.sh",
    "test:sql": "bash tests/sql/run.sh",
    "test:e2e": "python3 tests/e2e/run_e2e.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
