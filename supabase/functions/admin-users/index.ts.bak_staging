// Punto de entrada de la Edge Function en Supabase (Deno).
// Variables (secrets del proyecto, NUNCA en el frontend): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, APP_URL
import { createClient } from 'npm:@supabase/supabase-js@2';
import { handle } from './handler.js';

const url = Deno.env.get('SUPABASE_URL')!;
const serviceKey = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!;
const appUrl = (Deno.env.get('APP_URL') ?? '').replace(/\/$/, '');
const admin = createClient(url, serviceKey, { auth: { persistSession: false, autoRefreshToken: false } });

const withCarriers = async (rows: any[]) => {
  const ids = rows.map((r) => r.id);
  if (!ids.length) return rows;
  const { data } = await admin.from('user_carriers').select('user_id, carrier_id').in('user_id', ids);
  return rows.map((r) => ({ ...r, carriers: (data ?? []).filter((x: any) => x.user_id === r.id).map((x: any) => x.carrier_id) }));
};
const must = <T>(res: { data: T; error: any }) => { if (res.error) throw new Error(res.error.message); return res.data; };
const authOk = (r: { error: any }) => { if (r.error) throw new Error(r.error.message); };

const deps = {
  redirectTo: appUrl ? appUrl + '/#/crear-contrasena' : undefined,
  async getUserFromJwt(jwt: string) { const { data } = await admin.auth.getUser(jwt); return data?.user ? { id: data.user.id } : null; },
  async getProfile(id: string) { const { data } = await admin.from('profiles').select('*').eq('id', id).maybeSingle(); return data ? (await withCarriers([data]))[0] : null; },
  async listProfiles() { return withCarriers(must(await admin.from('profiles').select('*').order('full_name')) as any[]); },
  async hasHistory(id: string) { return !!must(await admin.rpc('user_has_history', { p_user: id })); },
  async activeRoutes(id: string) { return (must(await admin.rpc('user_active_routes', { p_user: id })) as any[]) ?? []; },
  async inviteUser(email: string, redirectTo?: string) { const r = await admin.auth.admin.inviteUserByEmail(email, { redirectTo }); authOk(r); return { id: r.data.user!.id }; },
  // Para un usuario que todavía no confirmó, invitar de nuevo reenvía el email al MISMO usuario (no crea otro).
  async resendInvite(email: string, redirectTo?: string) { authOk(await admin.auth.admin.inviteUserByEmail(email, { redirectTo })); },
  async deleteAuthUser(id: string) { authOk(await admin.auth.admin.deleteUser(id)); },
  async createProfileAtomic(p: any, carriers: string[]) {
    must(await admin.rpc('admin_create_profile', { p_id: p.id, p_full_name: p.full_name, p_email: p.email, p_phone: p.phone, p_role: p.role, p_status: p.status, p_carriers: carriers, p_created_by: p.created_by }));
  },
  async updateProfileAtomic(id: string, f: any) {
    must(await admin.rpc('admin_update_profile', { p_user: id, p_full_name: f.full_name, p_phone: f.phone, p_email: f.email, p_role: f.role, p_carriers: f.carriers, p_set_supervisor: f.set_supervisor, p_supervisor: f.supervisor }));
  },
  async setDisabledModules(id: string, mods: string[]) { must(await admin.rpc('admin_set_disabled_modules', { p_user: id, p_modules: mods })); },
  async updateStatus(id: string, patch: any) { must(await admin.from('profiles').update(patch).eq('id', id)); },
  async setCarriersAtomic(id: string, carriers: string[]) { must(await admin.rpc('set_user_carriers', { p_user: id, p_carriers: carriers })); },
  async updateAuthEmail(id: string, email: string) { authOk(await admin.auth.admin.updateUserById(id, { email, email_confirm: true })); },
  async sendPasswordReset(email: string, redirectTo?: string) { authOk(await admin.auth.resetPasswordForEmail(email, { redirectTo })); },
  async revokeSessions(id: string) { return must(await admin.rpc('revoke_user_sessions', { p_user: id })); },
  async reassignRoutes(from: string, to: string) { return must(await admin.rpc('reassign_active_routes', { p_from: from, p_to: to })); },
  async banUser(id: string) { authOk(await admin.auth.admin.updateUserById(id, { ban_duration: '876000h' })); },
  async unbanUser(id: string) { authOk(await admin.auth.admin.updateUserById(id, { ban_duration: 'none' })); },
  async deleteProfileAndAuth(id: string) { authOk(await admin.auth.admin.deleteUser(id)); },
  async audit(entry: any) { must(await admin.from('audit_log').insert(entry)); }
};

Deno.serve(async (req) => {
  try { return await handle(req, deps); }
  catch (e) { return new Response(JSON.stringify({ error: String((e as Error).message || e), code: 'SERVER_ERROR' }), { status: 500, headers: { 'content-type': 'application/json' } }); }
});
