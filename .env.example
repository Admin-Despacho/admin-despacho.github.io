# ===== Frontend (Cloudflare Pages → Settings → Environment variables). Solo valores PÚBLICOS. =====
# Sin estas dos variables la app arranca en MODO DEMO (sin servidor).
VITE_SUPABASE_URL=https://TU-PROYECTO-OK-DESPACHO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# ===== Secrets de Edge Functions (supabase secrets set ...). NUNCA en el frontend ni en el repositorio. =====
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
APP_URL=https://okdespacho.pages.dev            # origen exacto de la app (https, sin barra final ni ruta)
WEBAUTHN_RP_ID=okdespacho.pages.dev             # dominio de la app SIN https:// (debe coincidir con APP_URL)
RESEND_API_KEY=re_xxx
REPORT_FROM=OK Despacho <informes@okaccesorios.com.ar>
CRON_SECRET=una-clave-larga-al-azar
